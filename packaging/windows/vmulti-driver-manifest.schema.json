{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mouse Pressure VMulti release payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "hardware_id",
    "inf",
    "catalog",
    "driver",
    "provisioner",
    "license",
    "third_party_notices",
    "sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "mouse-pressure-vmulti" },
    "hardware_id": { "const": "ROOT\\MOUSEPRESSUREVMULTI" },
    "inf": { "type": "string", "pattern": "^[^/\\\\]+\\.inf$" },
    "catalog": { "type": "string", "pattern": "^[^/\\\\]+\\.cat$" },
    "driver": { "type": "string", "pattern": "^[^/\\\\]+\\.sys$" },
    "provisioner": { "type": "string", "pattern": "^[^/\\\\]+\\.exe$" },
    "license": { "type": "string", "pattern": "^[^/\\\\]+$" },
    "third_party_notices": { "type": "string", "pattern": "^[^/\\\\]+$" },
    "sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
      }
    }
  }
}
